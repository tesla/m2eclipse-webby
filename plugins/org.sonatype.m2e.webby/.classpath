<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" path="src"/>
	<classpathentry exported="true" kind="lib" path="jars/cargo-core-uberjar.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/ant.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/ant-launcher.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/commons-discovery.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/commons-logging.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/jdom2.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/jaxen.jar"/>
	<classpathentry exported="true" kind="lib" path="jars/maven-filtering.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
