Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Web Application Launcher for M2Eclipse Tests
Bundle-Vendor: Tesla
Bundle-SymbolicName: org.sonatype.m2e.webby.test
Bundle-Version: 0.3.2.qualifier
Fragment-Host: org.sonatype.m2e.webby
Automatic-Module-Name: org.sonatype.m2e.webby.test
Require-Bundle: org.eclipse.swtbot.swt.finder,
 org.eclipse.swtbot.eclipse.finder,
 org.eclipse.ui.workbench,
 org.eclipse.ui.navigator,
 org.eclipse.jface,
 org.eclipse.swt,
 org.eclipse.text
Import-Package: org.junit.jupiter.api;version="[5.10.0,6.0.0)",
 org.junit.jupiter.api.extension;version="[5.10.0,6.0.0)",
 org.junit.jupiter.api.function;version="[5.10.0,6.0.0)",
 org.junit.jupiter.api.io;version="[5.10.0,6.0.0)",
 org.junit.jupiter.params;version="[5.10.0,6.0.0)",
 org.junit.jupiter.params.provider;version="[5.10.0,6.0.0)",
 org.junit.platform.suite.api;version="[1.10.0,2.0.0)"
Bundle-ClassPath: .
Bundle-RequiredExecutionEnvironment: JavaSE-21
