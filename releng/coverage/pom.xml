<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sonatype.m2e.webby</groupId>
    <artifactId>org.sonatype.m2e.webby.parent</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>org.sonatype.m2e.webby.coverage</artifactId>
  <packaging>pom</packaging>
  <name>M2E Webby Coverage Report</name>

  <!-- Aggregates the JaCoCo data recorded while running the test fragment into target/site/jacoco-aggregate/jacoco.xml -->
  <dependencies>
    <dependency>
      <groupId>org.sonatype.m2e.webby</groupId>
      <artifactId>org.sonatype.m2e.webby</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sonatype.m2e.webby</groupId>
      <artifactId>org.sonatype.m2e.webby.test</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <configuration>
              <includes>
                <include>org/sonatype/m2e/webby/**</include>
              </includes>
              <excludes>
                <exclude>**/*Test.class</exclude>
                <exclude>**/*Test$*.class</exclude>
                <exclude>org/sonatype/m2e/webby/tests/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
